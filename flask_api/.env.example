# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Required: Groq API key for LLM generation and image vision
GROQ_API_KEY=your_groq_api_key_here

# Optional: Model paths (defaults to flask_api/ directory)
# THEME_MODEL_PATH=/path/to/theme_model.pkl
# STRUCTURE_MODEL_PATH=/path/to/topics_structures.pkl

# Optional: Flask port (default 5001)
# PORT=5001
